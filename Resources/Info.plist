<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sidest Bar</string>
	<!-- CFBundleExecutable 必须等于 build.sh 拷进 Contents/MacOS 的二进制名（SPM target "SidestMac"）。
	     改成 SidestBar 会让 LaunchServices 找不到可执行文件、app 无法启动；产品显示名由上面的
	     CFBundleDisplayName/CFBundleName 决定，无需动这里。 -->
	<key>CFBundleExecutable</key>
	<string>SidestMac</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>ai.sidest.sidedesk</string>
	<key>CFBundleName</key>
	<string>Sidest Bar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Sidest.ai</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sidest Bar needs microphone access to transcribe your speech into text and insert it into the active application.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sidest Bar uses speech recognition to convert your spoken words into text.</string>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://cdn.bigjing.com/updates/sidestmac/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>XYiIzNnzhDxkfPaKcyjWTi4aPiaZWHorMnlShJWIxv4=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
</dict>
</plist>
