<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-macos15.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <!-- 组合根（最外层）：同时引用平台无关层与 macOS 原生实现层。 -->
    <ProjectReference Include="..\SideDesk.Core\SideDesk.Core.csproj" />
    <ProjectReference Include="..\SideDesk.Services\SideDesk.Services.csproj" />
    <ProjectReference Include="..\SideDesk.Platform.Mac\SideDesk.Platform.Mac.csproj" />
  </ItemGroup>
</Project>
